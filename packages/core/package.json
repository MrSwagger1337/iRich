{
  "name": "@irich/core",
  "version": "0.1.0",
  "description": "Core data model, state machine, and engine for iRich editor",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrSwagger1337/iRich.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MrSwagger1337/iRich#readme",
  "bugs": "https://github.com/MrSwagger1337/iRich/issues",
  "keywords": [
    "irich",
    "editor",
    "wysiwyg",
    "page-builder",
    "content-editor",
    "headless",
    "framework-agnostic"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
