{
  "name": "@irich/plugin-sdk",
  "version": "0.1.0",
  "description": "Plugin SDK for authoring iRich editor extensions and components",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrSwagger1337/iRich.git",
    "directory": "packages/plugin-sdk"
  },
  "homepage": "https://github.com/MrSwagger1337/iRich#readme",
  "bugs": "https://github.com/MrSwagger1337/iRich/issues",
  "keywords": [
    "irich",
    "plugin",
    "plugin-sdk",
    "extensions",
    "editor-plugin"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@irich/core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
