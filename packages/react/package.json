{
  "name": "@irich/react",
  "version": "0.1.0",
  "description": "React components, hooks, and context bindings for iRich visual content editor",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MrSwagger1337/iRich.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MrSwagger1337/iRich#readme",
  "bugs": "https://github.com/MrSwagger1337/iRich/issues",
  "keywords": [
    "irich",
    "react",
    "visual-editor",
    "page-builder",
    "drag-and-drop",
    "wysiwyg",
    "inspector"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@irich/core": "workspace:*",
    "@irich/plugin-sdk": "workspace:*",
    "@irich/renderer": "workspace:*",
    "@irich/rich-text": "workspace:*",
    "@irich/ui": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
