{
  "name": "@irich/rich-text",
  "version": "0.1.0",
  "description": "Rich-text formatting extensions, inline marks, and textual primitives for iRich",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MrSwagger1337/iRich.git",
    "directory": "packages/rich-text"
  },
  "homepage": "https://github.com/MrSwagger1337/iRich#readme",
  "bugs": "https://github.com/MrSwagger1337/iRich/issues",
  "keywords": [
    "irich",
    "rich-text",
    "tiptap",
    "prosemirror",
    "wysiwyg",
    "editor"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@irich/core": "workspace:*",
    "@irich/plugin-sdk": "workspace:*",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^30.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
