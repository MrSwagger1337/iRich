{
  "name": "irich-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "iRich - Extensible visual content editor and page builder for React",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "turbo run dev",
    "dev:playground": "pnpm --filter playground-app dev",
    "dev:docs": "pnpm --filter docs-app dev",
    "dev:nextjs-example": "pnpm --filter example-nextjs-basic dev",
    "dev:vite-example": "pnpm --filter example-react-vite dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.5.1",
    "turbo": "^2.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  },
  "packageManager": "pnpm@12.4.2"
}
